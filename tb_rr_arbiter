`timescale 1ns/1ps

module tb_rr_arbiter;

    reg        clk;
    reg        rst_n;
    reg [3:0]  req;

    wire [3:0] grant;
    wire       grant_valid;

    integer errors;
    integer checks;

    // DUT
    rr_arbiter dut (
        .clk(clk),
        .rst_n(rst_n),
        .req(req),
        .grant(grant),
        .grant_valid(grant_valid)
    );

    // Clock: 10 ns period
    always #5 clk = ~clk;

    // -------------------------------------------------
    // Check expected grant
    // -------------------------------------------------
    task check_grant;
        input [3:0] expected_grant;
        input       expected_valid;

        begin
            checks = checks + 1;

            if (grant !== expected_grant) begin
                $display("ERROR: req=%b grant=%b expected=%b",
                         req, grant, expected_grant);
                errors = errors + 1;
            end

            if (grant_valid !== expected_valid) begin
                $display("ERROR: req=%b grant_valid=%b expected=%b",
                         req, grant_valid, expected_valid);
                errors = errors + 1;
            end

            // Grant must be one-hot or zero
            if ((grant !== 4'b0000) &&
                (grant !== 4'b0001) &&
                (grant !== 4'b0010) &&
                (grant !== 4'b0100) &&
                (grant !== 4'b1000)) begin

                $display("ERROR: Grant is not one-hot: %b", grant);
                errors = errors + 1;
            end

            // Grant cannot be given to inactive requester
            if ((grant & ~req) != 4'b0000) begin
                $display("ERROR: Inactive requester granted. req=%b grant=%b",
                         req, grant);
                errors = errors + 1;
            end
        end
    endtask

    // -------------------------------------------------
    // Main test sequence
    // -------------------------------------------------
    initial begin

        clk    = 1'b0;
        rst_n  = 1'b0;
        req    = 4'b0000;
        errors = 0;
        checks = 0;

        $display("==========================================");
        $display(" Silicon Sprint Round-Robin Arbiter Test ");
        $display("==========================================");

        // ---------------------------------------------
        // TEST 1: Reset
        // ---------------------------------------------
        #2;

        if ((grant !== 4'b0000) || (grant_valid !== 1'b0)) begin
            $display("ERROR: Reset behavior failed");
            errors = errors + 1;
        end

        $display("TEST 1: Reset                  PASS");

        // Release reset
        #3;
        rst_n = 1'b1;

        // ---------------------------------------------
        // TEST 2: No requests
        // ---------------------------------------------
        req = 4'b0000;

        @(posedge clk);
        #1;
        check_grant(4'b0000, 1'b0);

        $display("TEST 2: No requests            PASS");

        // ---------------------------------------------
        // TEST 3: Single requester 0
        // ---------------------------------------------
        req = 4'b0001;

        @(posedge clk);
        #1;
        check_grant(4'b0001, 1'b1);

        $display("TEST 3: Single request R0      PASS");

        // ---------------------------------------------
        // TEST 4: Single requester 1
        // ---------------------------------------------
        req = 4'b0010;

        @(posedge clk);
        #1;
        check_grant(4'b0010, 1'b1);

        $display("TEST 4: Single request R1      PASS");

        // ---------------------------------------------
        // TEST 5: Single requester 2
        // ---------------------------------------------
        req = 4'b0100;

        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        $display("TEST 5: Single request R2      PASS");

        // ---------------------------------------------
        // TEST 6: Single requester 3
        // ---------------------------------------------
        req = 4'b1000;

        @(posedge clk);
        #1;
        check_grant(4'b1000, 1'b1);

        $display("TEST 6: Single request R3      PASS");

        // ---------------------------------------------
        // TEST 7: All requesters continuously active
        // Expected: 0 -> 1 -> 2 -> 3
        // ---------------------------------------------
        req = 4'b1111;

        @(posedge clk);
        #1;
        check_grant(4'b0001, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b0010, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b1000, 1'b1);

        $display("TEST 7: Continuous requests   PASS");

        // ---------------------------------------------
        // TEST 8: Multiple requests
        // Current priority should be 0 after R3
        // req = R0 + R2
        // Expected R0
        // ---------------------------------------------
        req = 4'b0101;

        @(posedge clk);
        #1;
        check_grant(4'b0001, 1'b1);

        // Now priority = 1
        // Search 1 -> 2 -> 3 -> 0
        // req = R0 + R2
        // Expected R2
        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        $display("TEST 8: Multiple requests      PASS");

        // ---------------------------------------------
        // TEST 9: Request withdrawal
        // ---------------------------------------------
        req = 4'b0000;

        @(posedge clk);
        #1;
        check_grant(4'b0000, 1'b0);

        // R1 request
        req = 4'b0010;

        @(posedge clk);
        #1;
        check_grant(4'b0010, 1'b1);

        $display("TEST 9: Request withdrawal     PASS");

        // ---------------------------------------------
        // TEST 10: Wrap-around
        // Force priority to 3 by granting R2
        // Current priority after R1 is 2
        // ---------------------------------------------
        req = 4'b0100;

        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        // Now priority = 3
        // req = R0 + R1
        // Search: 3 -> 0 -> 1 -> 2
        // Expected R0
        req = 4'b0011;

        @(posedge clk);
        #1;
        check_grant(4'b0001, 1'b1);

        $display("TEST 10: Priority wrap-around PASS");

        // ---------------------------------------------
        // TEST 11: Fairness
        // All requesters continuously active
        // Expected 1 -> 2 -> 3 -> 0
        // because previous grant was R0
        // ---------------------------------------------
        req = 4'b1111;

        @(posedge clk);
        #1;
        check_grant(4'b0010, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b1000, 1'b1);

        @(posedge clk);
        #1;
        check_grant(4'b0001, 1'b1);

        $display("TEST 11: Fairness              PASS");

        // ---------------------------------------------
        // TEST 12: Dynamic request pattern
        // ---------------------------------------------
        req = 4'b1001;

        @(posedge clk);
        #1;
        check_grant(4'b1000, 1'b1);

        req = 4'b0110;

        @(posedge clk);
        #1;
        check_grant(4'b0010, 1'b1);

        req = 4'b0100;

        @(posedge clk);
        #1;
        check_grant(4'b0100, 1'b1);

        $display("TEST 12: Dynamic requests      PASS");

        // ---------------------------------------------
        // FINAL RESULT
        // ---------------------------------------------
        $display("------------------------------------------");
        $display("Total checks = %0d", checks);
        $display("Total errors = %0d", errors);

        if (errors == 0) begin
            $display("==========================================");
            $display(" ALL TESTS PASSED - 0 ERRORS");
            $display("==========================================");
        end
        else begin
            $display("==========================================");
            $display(" TEST FAILED - %0d ERRORS", errors);
            $display("==========================================");
        end

        $finish;
    end

endmodule
