module rr_arbiter (
    input        clk,
    input        rst_n,
    input  [3:0] req,
    output reg [3:0] grant,
    output reg       grant_valid
);

    // Priority pointer: 0, 1, 2, or 3
    reg [1:0] priority;

    reg [1:0] next_priority;
    reg [3:0] next_grant;
    reg       next_grant_valid;

    // Combinational arbitration logic
    always @(*) begin

        // Default values
        next_grant       = 4'b0000;
        next_grant_valid = 1'b0;
        next_priority    = priority;

        // Round-robin search
        case (priority)

            2'd0: begin
                if (req[0]) begin
                    next_grant       = 4'b0001;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd1;
                end
                else if (req[1]) begin
                    next_grant       = 4'b0010;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd2;
                end
                else if (req[2]) begin
                    next_grant       = 4'b0100;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd3;
                end
                else if (req[3]) begin
                    next_grant       = 4'b1000;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd0;
                end
            end

            2'd1: begin
                if (req[1]) begin
                    next_grant       = 4'b0010;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd2;
                end
                else if (req[2]) begin
                    next_grant       = 4'b0100;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd3;
                end
                else if (req[3]) begin
                    next_grant       = 4'b1000;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd0;
                end
                else if (req[0]) begin
                    next_grant       = 4'b0001;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd1;
                end
            end

            2'd2: begin
                if (req[2]) begin
                    next_grant       = 4'b0100;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd3;
                end
                else if (req[3]) begin
                    next_grant       = 4'b1000;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd0;
                end
                else if (req[0]) begin
                    next_grant       = 4'b0001;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd1;
                end
                else if (req[1]) begin
                    next_grant       = 4'b0010;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd2;
                end
            end

            2'd3: begin
                if (req[3]) begin
                    next_grant       = 4'b1000;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd0;
                end
                else if (req[0]) begin
                    next_grant       = 4'b0001;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd1;
                end
                else if (req[1]) begin
                    next_grant       = 4'b0010;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd2;
                end
                else if (req[2]) begin
                    next_grant       = 4'b0100;
                    next_grant_valid = 1'b1;
                    next_priority    = 2'd3;
                end
            end

        endcase
    end

    // Sequential logic
    // Active-low asynchronous reset
    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin
            priority    <= 2'd0;
            grant       <= 4'b0000;
            grant_valid <= 1'b0;
        end
        else begin
            priority    <= next_priority;
            grant       <= next_grant;
            grant_valid <= next_grant_valid;
        end

    end

endmodule
